{
  "name": "cash-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:load": "docker compose run --rm k6 run --summary-export=/results/daily-balance-peak-50rps.json /scripts/load/daily-balance-peak.js",
    "test:resilience": "node tests/resilience/consolidated-outage.mjs",
    "test:resilience:redis": "node tests/resilience/dependency-outage-under-load.mjs redis",
    "test:resilience:database": "node tests/resilience/dependency-outage-under-load.mjs postgres-daily-balance"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
