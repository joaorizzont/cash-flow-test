{
  "uid": "cash-flow",
  "title": "Cash Flow",
  "tags": ["cash-flow"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "row",
      "title": "Visão geral",
      "id": 1,
