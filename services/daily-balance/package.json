{
  "name": "@cash-flow/daily-balance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "dev:consumer": "tsx watch --conditions=source --env-file-if-exists=.env src/consumer.ts",
    "start:consumer": "node dist/consumer.js",
    "rebuild-day": "tsx --conditions=source --env-file-if-exists=.env src/rebuild-day.ts",
    "redrive": "tsx --conditions=source --env-file-if-exists=.env src/redrive-dead-letters.ts"
  },
  "dependencies": {
    "@cash-flow/contracts": "*",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-typebox": "^6.1.0",
    "amqplib": "^2.2.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "redis": "^6.3.0",
    "typebox": "^1.3.36",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/rabbitmq": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/pg": "^8.23.1",
    "testcontainers": "^12.2.0"
  }
}
