{
  "name": "@cash-flow/ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "dev:relay": "tsx watch --conditions=source --env-file-if-exists=.env src/relay.ts",
    "start:relay": "node dist/relay.js"
  },
  "dependencies": {
    "@cash-flow/contracts": "*",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "amqplib": "^2.2.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "typebox": "^1.3.36",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/rabbitmq": "^12.2.0",
    "@types/pg": "^8.23.1",
    "testcontainers": "^12.2.0"
  }
}
