{
  "name": "@cash-flow/ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --conditions=source --import ./src/telemetry.ts --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import ./dist/telemetry.js dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "dev:relay": "PORT=3011 OTEL_SERVICE_NAME=ledger-outbox-relay tsx watch --conditions=source --import ./src/telemetry.ts --env-file-if-exists=.env src/relay.ts",
    "start:relay": "node --import ./dist/telemetry.js dist/relay.js"
  },
  "dependencies": {
    "@cash-flow/contracts": "*",
    "@fastify/helmet": "^13.1.2",
    "@fastify/otel": "^0.21.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-amqplib": "^0.70.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-pg": "^0.75.0",
    "@opentelemetry/instrumentation-pino": "^0.69.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "amqplib": "^2.2.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "typebox": "^1.3.36",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/rabbitmq": "^12.2.0",
    "@types/pg": "^8.23.1",
    "testcontainers": "^12.2.0"
  }
}
